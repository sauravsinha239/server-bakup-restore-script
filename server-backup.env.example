# Optional environment overrides for server-backup.sh
# DO NOT commit this file to Git. It can contain database credentials.

# Where backups are stored
BACKUP_ROOT=/root/server-backups
RETENTION=8

# MongoDB. If authentication is enabled, use a URI such as:
# MONGO_URI=mongodb://backupuser:CHANGE_ME@127.0.0.1:27017/?authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017

# MSSQL. Prefer a dedicated backup account with only required permissions.
# Leave MSSQL_USER empty when sqlcmd uses integrated/local authentication.
MSSQL_SERVER=localhost
MSSQL_USER=
MSSQL_PASSWORD=
# Temporary SQL Server backup location; it must be writable by mssql-server.
MSSQL_BACKUP_DIR=/var/opt/mssql/backup
